          },
          "reviewsCount": {
            "label": "Reviews",
            "format": "number"
          },
          "imagesCount": {
            "label": "Photos",
            "format": "number"
          },
          "socials": {
            "label": "Socials",
            "format": "object"
          },
          "googleMapsUrl": {
