{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Business name as shown on Google Maps."
      },
      "category": {
        "type": [
          "string",
          "null"
        ],
        "description": "Primary Google Maps category."
      },
      "categories": {
        "type": "array",
        "description": "All Google Maps categories, primary first.",
        "items": { "type": "string" }
      },
      "street": {
        "type": ["string", "null"],
        "description": "Street line of the address."
      },
      "neighborhood": {
        "type": ["string", "null"],
        "description": "Neighborhood, if Google provides one."
      },
      "city": {
        "type": ["string", "null"],
        "description": "City or locality."
      },
      "state": {
        "type": ["string", "null"],
        "description": "State, region, or administrative area."
      },
      "postalCode": {
        "type": ["string", "null"],
        "description": "Postal code."
      },
      "countryCode": {
        "type": ["string", "null"],
        "description": "ISO country code, e.g. US."
      },
      "address": {
        "type": [
          "string",
          "null"
        ],
        "description": "Full street address."
      },
      "phone": {
        "type": [
          "string",
          "null"
        ],
        "description": "Phone number from the Maps listing."
      },
      "website": {
        "type": [
          "string",
          "null"
        ],
        "description": "Business website, cleaned of Google redirects and utm_ parameters."
      },
      "rating": {
        "type": [
          "number",
          "null"
        ],
        "description": "Average star rating (1-5)."
      },
      "reviewsCount": {
        "type": [
          "number",
          "null"
        ],
        "description": "Number of Google reviews."
      },
      "reviewsDistribution": {
        "type": ["object", "null"],
        "description": "Review counts by star rating.",
        "properties": {
          "oneStar": { "type": "number" },
          "twoStar": { "type": "number" },
          "threeStar": { "type": "number" },
          "fourStar": { "type": "number" },
          "fiveStar": { "type": "number" }
        }
      },
      "priceLevel": {
        "type": [
          "string",
          "null"
        ],
        "description": "Price level label, e.g. $$."
      },
      "closedStatus": {
        "type": [
          "string",
          "null"
        ],
        "description": "permanently_closed or temporarily_closed, null if open."
      },
      "permanentlyClosed": {
        "type": "boolean",
        "description": "True when Google marks the place permanently closed."
      },
      "temporarilyClosed": {
        "type": "boolean",
        "description": "True when Google marks the place temporarily closed."
      },
      "plusCode": {
        "type": [
          "string",
          "null"
        ],
        "description": "Google Plus Code."
      },
      "location": {
        "type": [
          "object",
          "null"
        ],
        "description": "Coordinates {lat, lng}."
      },
      "placeId": {
        "type": [
          "string",
          "null"
        ],
        "description": "Google place ID."
      },
      "cid": {
        "type": [
          "string",
          "null"
        ],
        "description": "Google customer ID (CID) as a decimal string."
      },
      "fid": {
        "type": ["string", "null"],
        "description": "Google feature id, 0xhex:0xhex."
      },
      "googleMapsUrl": {
        "type": "string",
        "description": "Link to the place on Google Maps."
      },
      "openingHours": {
        "type": [
          "array",
          "null"
        ],
        "description": "Opening hours, one 'Day: hours' string per day."
      },
      "description": {
        "type": ["string", "null"],
        "description": "Short place description from Google, when one is published."
      },
      "menuUrl": {
        "type": ["string", "null"],
        "description": "Menu link from the listing."
      },
      "reservationUrl": {
        "type": ["string", "null"],
        "description": "Table reservation link from the listing."
      },
      "imagesCount": {
        "type": ["number", "null"],
        "description": "Number of photos on the listing. Photo files are not downloaded."
      },
      "popularTimesHistogram": {
        "type": ["object", "null"],
        "description": "Hourly busyness by weekday. Keys are monday through sunday. Each value is {hour, occupancyPercent}. Null when Google omits popular times."
      },
      "popularTimesLiveText": {
        "type": ["string", "null"],
        "description": "Live busyness label, e.g. A little busy."
      },
      "popularTimesLivePercent": {
        "type": ["number", "null"],
        "description": "Live busyness as a percent."
      },
      "reviews": {
        "type": "array",
        "description": "Google reviews included when maxReviews is greater than 0. Empty otherwise.",
        "items": { "type": "object" }
      },
      "searchTerm": {
        "type": [
          "string",
          "null"
        ],
        "description": "Search term that found this place."
      },
      "rank": {
        "type": [
          "number",
          "null"
        ],
        "description": "Position in the search results."
      },
      "emails": {
        "type": "array",
        "description": "Emails found on the business website (empty if enrichment is off). Third-party mailboxes are listed separately."
      },
      "thirdPartyEmails": {
        "type": "array",
        "description": "Emails whose domain is not this business and not a personal mailbox, such as a booking tool, a parent brand, or an agency."
      },
      "impressumOwner": {
        "type": ["string", "null"],
        "description": "Owner or managing director named on a German Impressum. Null outside Germany."
      },
      "vatId": {
        "type": ["string", "null"],
        "description": "VAT ID from a German Impressum, for example DE123456789. Null when the page has none."
      },
      "socials": {
        "type": "object",
        "description": "Social profile URLs found on the website, keyed by network."
      },
      "websitePhones": {
        "type": "array",
        "description": "Phone numbers found on the website."
      },
      "contactsStatus": {
        "type": "string",
        "description": "ok, skipped, no_website, or an error message for website enrichment."
      },
      "scrapedAt": {
        "type": "string",
        "description": "ISO timestamp of the scrape."
      }
    },
    "required": [
      "title"
    ]
  },
  "views": {
    "leads": {
      "title": "Leads",
      "transformation": {
        "flatten": ["reviewsDistribution", "location"],
        "fields": [
          "title",
          "category",
          "categories",
          "phone",
          "emails",
          "thirdPartyEmails",
          "impressumOwner",
          "vatId",
          "websitePhones",
          "website",
          "socials",
          "contactsStatus",
          "address",
          "street",
          "neighborhood",
          "city",
          "state",
          "postalCode",
          "countryCode",
          "rating",
          "reviewsCount",
          "reviewsDistribution.oneStar",
          "reviewsDistribution.twoStar",
          "reviewsDistribution.threeStar",
          "reviewsDistribution.fourStar",
          "reviewsDistribution.fiveStar",
          "imagesCount",
          "priceLevel",
          "openingHours",
          "permanentlyClosed",
          "temporarilyClosed",
          "description",
          "menuUrl",
          "reservationUrl",
          "location.lat",
          "location.lng",
          "googleMapsUrl"
        ]
      },
      "display": {
